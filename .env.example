# ═══════════════════════════════════════════════════════════════════
#  ШАБЛОН НАСТРОЕК БОТА
#  Скопируй этот файл под именем .env (рядом с main.py) и заполни.
#     Windows:   copy .env.example .env
#     Linux/Mac: cp .env.example .env
#  .env НИКОГДА не выкладывай публично — там токены и ключи.
#  Всё, что помечено (опция), можно не заполнять — есть значения
#  по умолчанию прямо в config.py.
# ═══════════════════════════════════════════════════════════════════

# ─── Telegram (ОБЯЗАТЕЛЬНО) ────────────────────────────────────────

# Токен бота: @BotFather → /mybots → твой бот → API Token
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=

# ─── Каталог и база (опция) ────────────────────────────────────────

# Пути (по умолчанию — рядом с main.py)
# DB_PATH=subscriptions.db
# CATALOG_PATH=catalog.json

# ─── Валюта и отображение цен (опция) ─────────────────────────────

# Базовая валюта каталога (рекомендуется USDT)
# BASE_CURRENCY=USDT
# CURRENCY=USD
# CURRENCY_SYMBOL=$
# Показывать рублёвый эквивалент рядом с ценой
# SHOW_RUB_EQUIVALENT=true
# Курс для рублёвого эквивалента: 1 USDT = N ₽
# USDT_RUB_RATE=95

# ─── TON / USDT платежи ────────────────────────────────────────────

# Toncenter API key (https://toncenter.com/api/v2/) — без ключа медленнее
TONCENTER_API_KEY=

# Адрес кошелька для приёма TON/USDT
TON_WALLET_ADDRESS=

# Интервал проверки оплат (сек) и время жизни неоплаченного заказа (сек)
# TON_CHECK_INTERVAL=30
# TON_PAYMENT_TTL=1800

# TonAPI.io ключ — надёжная проверка USDT-переводов (опция, рекомендую)
# TONAPI_KEY=

# ─── Карты: Digiseller ─────────────────────────────────────────────

# my.digiseller.com → Мой аккаунт (продавец)
DIGISELLER_SELLER_ID=
# API-ключ (нужно право «Статистика продаж»)
DIGISELLER_API_KEY=
# ID товара с «произвольной ценой» (id_d)
DIGISELLER_PRODUCT_ID=

# Валюта страницы оплаты: RUB | USD | EUR
# DIGISELLER_CURRENCY=RUB
# Минимальная цена юнита товара (задана в панели Digiseller)
# DIGISELLER_UNIT_PRICE=1.0
# Валюта юнита в панели: RUB | WMT | WMZ | USD | EUR (см. докстринг config.py)
# DIGISELLER_PRODUCT_CURRENCY=
# Домен для генерации email-привязки заказов
# DIGISELLER_EMAIL_DOMAIN=orders.digibot.pay
# ID текстового параметра товара (чистый матчинг без фейк-email) — рекомендую
# DIGISELLER_PARAM_ID=
# Интервал фоновой проверки оплат (сек)
# DIGISELLER_CHECK_INTERVAL=60
# Мягкая проверка суммы (email-матчинг без сверки суммы) — нужно для RUB→WMT
# DIGISELLER_SKIP_AMOUNT_CHECK=true

# ─── Карты: Tribute (альтернатива Digiseller, комиссия 10%) ───────

# @tribute → веб-приложение → Настройки → «Управление API-ключами».
# Если пусто — кнопка «Банковская карта» работает через Digiseller.
TRIBUTE_API_KEY=
# ID магазина — ОПЦИЯ для владельцев НЕСКОЛЬКИХ магазинов, задавать НЕ нужно.
# Без него заказ идёт в первый (самый ранний) магазин аккаунта.
# Но сам магазин должен СУЩЕСТВОВАТЬ в @tribute (раздел «Магазин»),
# иначе API вернёт «shop not found». Список магазинов бот печатает при старте.
# TRIBUTE_SHOP_ID=0
# Интервал проверки оплат (сек)
# TRIBUTE_CHECK_INTERVAL=15

# ─── Telegram Stars ────────────────────────────────────────────────

# Сколько Stars стоит 1 USDT
# STARS_PER_USDT=100

# ─── Включённые способы оплаты ─────────────────────────────────────

# Через запятую из: ton, usdt, card, stars
# ENABLED_PAYMENT_METHODS=ton,usdt,card,stars

# ─── Сеть ──────────────────────────────────────────────────────────

# Прокси для Telegram API, если заблокирован:
# http://user:pass@host:port или socks5://user:pass@host:port
PROXY_URL=

# ─── Рефералка и маркетинг ─────────────────────────────────────────

# Username бота без @ (опция — иначе возьмётся автоматически из Telegram)
# BOT_USERNAME=
# Бонус рефереру в USDT после первой оплаты друга
# REFERRAL_BONUS_USDT=0.50
# Сколько оплат друга нужно для бонуса
# REFERRAL_REQUIRED_ORDERS=1
# Кнопка «Промокод» в каталоге
# PROMO_CODE_ENABLED=true
# За сколько часов до конца подписки первое напоминание
# AUTO_RENEWAL_REMINDER_HOURS=72
# Drip-напоминания непокупавшим — только юзерам моложе этого срока (часов).
# Старая база не получает залп из 3 сообщений при первом запуске. 0 = без фильтра.
# DRIP_MAX_USER_AGE_HOURS=96
# Минимальная пауза между drip-сообщениями одному юзеру (часов)
# DRIP_MIN_GAP_HOURS=24

# ─── Mini App (веб-магазин) ────────────────────────────────────────

# Порт HTTP-сервера бота (health + Mini App + API). ОБЯЗАТЕЛЕН для
# хостинга: без него сервер вообще не запустится и магазину некуда
# будет открываться. На VPS под nginx ставь 8000 (nginx проксирует
# 80/443 → 127.0.0.1:8000). На Render/Railway переменную PORT задаёт
# платформа сама — ничего вписывать не нужно.
# PORT=8000

# Базовый публичный URL health-сервера (БЕЗ /app/). Примеры:
#   VPS:   WEBAPP_URL=https://твой-домен.ру
#   Render: WEBAPP_URL=https://mybot.onrender.com
# Магазин откроется на {WEBAPP_URL}/app/ и в меню чата появится
# кнопка «🛍 Магазин». Пусто = магазин только по прямой ссылке.

# Окно жизни подписи initData (в ЧАСАХ), v27.2. Было 1 час — юзеры
# ловили «сессия устарела» при долгом открытом магазине. 24 часа —
# практичный компромисс: подпись всё равно проверяется полностью.
# INITDATA_MAX_AGE_HOURS=24
# WEBAPP_URL=
# Название магазина в шапке Mini App
# STORE_NAME=SUBSTORE

# ─── Безопасность ──────────────────────────────────────────────────

# Fernet-ключ шифрования логинов/паролей товара. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если пусто — сгенерируется автоматически (для прода задай явно!)
ENCRYPTION_KEY=

# Через сколько дней после активации удалять данные аккаунта из БД (0 = никогда)
# ACCOUNT_DATA_TTL_DAYS=30

# ─── Гигиена чата ──────────────────────────────────────────────────

# Дедупликация: стираются ТОЛЬКО дубли — повторное открытие каталога /
# повтор команды / повторная оплата того же заказа удаляют предыдущую копию.
# Карточки заказов, оплаты и уведомления не удаляются никогда.
# CHAT_DEDUP_ENABLED=true

# Дедуп и в админских чатах (Task 35, решение владельца «во всех чатах»).
# false — прежнее поведение: админский чат не затрагивается дедупом.
# DEDUP_ADMINS=true

# Ephemeral-растворение переходных сообщений (Task 35): FSM-подсказки и
# ошибки стираются после завершения ввода, команды и нажатия кнопок меню
# юзера — через ~5 с во всех личных чатах. Критичные экраны (деньги,
# заказы, каталог, уведомления) не растворяются никогда.
# EPHEMERAL_ENABLED=true

# Нативные Ephemeral Messages (Bot API 10.3): transient-сообщения уходят
# с ephemeral_message_parameters — жизнью управляет Telegram. При любом
# отказе API бот тихо откатывается на классику. По умолчанию выключен:
# классика гарантирует доставку переходного сообщения.
# EPHEMERAL_NATIVE=false

# ─── Прочее (опция) ────────────────────────────────────────────────

# Пауза между сообщениями рассылки (сек) — анти-флуд Telegram
# BROADCAST_DELAY=0.05
# Интервал проверки напоминаний/маркетинга (сек)
# NOTIFY_CHECK_INTERVAL=30
