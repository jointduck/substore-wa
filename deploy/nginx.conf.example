# ─────────────────────────────────────────────────────────────────────
#  nginx: реверс-прокси для бота + Mini App
#
#  Что делает:
#    - HTTP (80) → редирект на HTTPS
#    - HTTPS (443) → проксирует всё на бот (127.0.0.1:8000)
#    - Mini App открывается на https://твой-домен.ру/app/
#
#  Установка:
#    1. Замени «твой-домен.ру» на свой домен во всём файле.
#    2. sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/indiasubbot
#       (на CentOS/Fedora путь другой: /etc/nginx/conf.d/indiasubbot.conf)
#    3. sudo ln -s /etc/nginx/sites-available/indiasubbot /etc/nginx/sites-enabled/
#    4. sudo nginx -t && sudo systemctl reload nginx
#    5. SSL-сертификат бесплатно (Let's Encrypt):
#         sudo apt install certbot python3-certbot-nginx
#         sudo certbot --nginx -d твой-домен.ру
#       certbot сам поправит конфиг и включит автопродление.
#
#  ВАЖНО для Telegram Mini App: HTTPS обязателен. HTTP-ссылку BotFather
#  не примет, и initData не будет подписана.
# ─────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name твой-домен.ру;

    # Всё на HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name твой-домен.ру;

    # Сертификаты появятся после certbot --nginx (см. шаг 5).
    # До этого можно временно закомментировать эти 2 строки
    # и раскомментировать только после выпуска сертификата.
    ssl_certificate     /etc/letsencrypt/live/твой-домен.ру/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/твой-домен.ру/privkey.pem;

    # Логи
    access_log /var/log/nginx/indiasubbot.access.log;
    error_log  /var/log/nginx/indiasubbot.error.log;

    # Основной проксирующий блок: бот + Mini App + API
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Долгие запросы (поллинг API) — не обрывать по таймауту
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Статика Mini App отдаётся ботом — клиентское кэширование
        # настроим через заголовки ответа:
        add_header Cache-Control "no-transform";
    }

    # Gzip для статики Mini App (index.html ~50KB, style.css, app.js)
    gzip on;
    gzip_types text/html text/css application/javascript application/json;
    gzip_min_length 1024;
}
