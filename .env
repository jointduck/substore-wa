# @tribute → веб-приложение → Настройки → «Управление API-ключами».
# Если пусто — кнопка «Банковская карта» работает через Digiseller.
#TRIBUTE_API_KEY=19806570-2a9f-4d3f-be48-9eeff3cf
# ID магазина (0 = первый магазин аккаунта)
#TRIBUTE_SHOP_ID=0
# Интервал проверки оплат (сек)
#TRIBUTE_CHECK_INTERVAL=15


# USDT to RUB rate for display purposes
USDT_RUB_RATE=95

# ─── Telegram Stars Payments ────────────────────────────────────────

# Exchange rate: how many Telegram Stars per 1 USDT
# Default: 100 stars = 1 USDT
STARS_PER_USDT=100

# ─── Available Payment Methods ─────────────────────────────────────

# Comma-separated list of enabled payment methods:
# "ton"   — Gram (formerly TON/Toncoin)
# "usdt"  — USDT (Tether on TON/Gram blockchain)
# "card"  — Bank card via Digiseller (oplata.info)
# "stars" — Telegram Stars (native Telegram currency, currency=XTR)
ENABLED_PAYMENT_METHODS=ton,usdt,card,stars

# ─── Security ──────────────────────────────────────────────────────

# Environment: "production" / "prod" for production, empty or "development" for dev
# When ENV=production, ENCRYPTION_KEY MUST be set explicitly — auto-generation is disabled!
ENV=

# Fernet encryption key for account_data (logins/passwords).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, a key will be auto-generated on first run (fine for dev, BAD for production!)
# IMPORTANT: Keep this secret! If lost, encrypted data cannot be recovered.
ENCRYPTION_KEY=

# Auto-delete account_data N days after order activation (0 = never delete)
# Recommended: 30 days — deletes login/password data after subscription is activated
ACCOUNT_DATA_TTL_DAYS=30

# ─── Broadcast ─────────────────────────────────────────────────────

# Delay between broadcast messages in seconds (to avoid Telegram rate limits)
# Default: 0.05 (50ms) — about 20 messages/sec, well within Telegram's ~30/sec limit
BROADCAST_DELAY=0.05

# ─── Proxy ─────────────────────────────────────────────────────────
#
# Proxy for Telegram API (needed if api.telegram.org is blocked by ISP).
# Leave empty to disable proxy.
#
# Supported formats:
#   HTTP/HTTPS:  http://user:pass@host:port
#                http://127.0.0.1:7890
#   SOCKS5:      socks5://user:pass@host:1080   (requires aiohttp-socks)
#                socks5://127.0.0.1:1080
#   SOCKS4:      socks4://host:1080             (requires aiohttp-socks)
#
# For SOCKS proxies install:  pip install aiohttp-socks
# (already in requirements.txt)
#
# Recommended for Russia: SOCKS5 from proxy6.net / proxy-seller.ru
# (≈100-300₽/month, stable). Free alternatives: spys.one/socks (unstable).
#
# Test before use (PowerShell):
#   curl.exe --proxy socks5://host:port https://api.telegram.org
#
PROXY_URL=http://127.0.0.1:3066
# Auto-generated encryption key — KEEP SECRET!
ENCRYPTION_KEY=thSimLYRqAC0W2Iy4V9iElSkR1JJjv6rmro5QErB2C4=
# ─── Рефералка и маркетинг ─────────────────────────────────────────

# Username бота без @ (опция — иначе возьмётся автоматически из Telegram)
# BOT_USERNAME=
# Бонус рефереру в USDT после первой оплаты друга
# REFERRAL_BONUS_USDT=0.50
# Сколько оплат друга нужно для бонуса
# REFERRAL_REQUIRED_ORDERS=1
# Кнопка «Промокод» в каталоге
# PROMO_CODE_ENABLED=true
# За сколько часов до конца подписки первое напоминание
# AUTO_RENEWAL_REMINDER_HOURS=72
# Drip-напоминания непокупавшим — только юзерам моложе этого срока (часов).
# Старая база не получает залп из 3 сообщений при первом запуске. 0 = без фильтра.
# DRIP_MAX_USER_AGE_HOURS=96
# Минимальная пауза между drip-сообщениями одному юзеру (часов)
# DRIP_MIN_GAP_HOURS=24

# ─── Безопасность ──────────────────────────────────────────────────

# Fernet-ключ шифрования логинов/паролей товара. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если пусто — сгенерируется автоматически (для прода задай явно!)
ENCRYPTION_KEY=

