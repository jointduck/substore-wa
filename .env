# ─── Currency & Pricing ────────────────────────────────────────────

# Base currency for catalog prices (USDT for crypto-friendly setup)
BASE_CURRENCY=USDT

# Display currency
CURRENCY=USD
CURRENCY_SYMBOL=$

# Show RUB equivalent alongside crypto prices
SHOW_RUB_EQUIVALENT=true

# ─── Card Payments (Digiseller) ──────────────────────────────────────
# Docs: https://my.digiseller.com/inside/api_payment.asp

# Digiseller seller ID (my.digiseller.com → Мой аккаунт)
DIGISELLER_SELLER_ID=1458464

# Digiseller API key (my.digiseller.com → API → API keys)
# The key MUST have permission: [Statistics] → Sales statistics
DIGISELLER_API_KEY=4E9787552B73427193AC494562CAA2FE

# Digiseller product ID (id_d) — the product buyers pay for.
# Create ONE product (recommended type: "произвольная цена" / free price)
# and put its numeric ID here. Users pay the exact RUB amount shown by the bot.
DIGISELLER_PRODUCT_ID=6107046

# Payment currency on the payment page (RUB | USD | EUR)
DIGISELLER_CURRENCY=RUB
# Минимальная цена одного юнита товара на Digiseller (в DIGISELLER_CURRENCY).
# Это значение «Минимальная цена» из карточки товара на my.digiseller.com.
#
# Digiseller работает с произвольной ценой через целые юниты:
#   итоговая сумма = DIGISELLER_UNIT_PRICE × unit_cnt (целое число)
#
# Пример: минимальная цена юнита 1 ₽ → юзер платит точную сумму в рублях.
#         минимальная цена юнита 10 ₽ → сумма округляется до кратной 10.
#
# РЕКОМЕНДАЦИЯ: установи «Минимальную цену» товара на Digiseller = 1 ₽
# (или 1 в другой валюте) и оставь здесь 1.0 — тогда юзер всегда платит
# точную сумму без округлений.
DIGISELLER_UNIT_PRICE=1.0

# Domain for per-order buyer emails used to match payments:
# email = "{order_id}@{DIGISELLER_EMAIL_DOMAIN}"
# Set it to your own domain.
DIGISELLER_EMAIL_DOMAIN=orders.example.com

# Optional: numeric ID of a required TEXT parameter on the product
# (product editor → Параметры товара). If set, the order id is bound via
# /api/purchases/options → id_po instead of the email trick (cleaner).
DIGISELLER_PARAM_ID=0

# Background payment check interval (seconds)
DIGISELLER_CHECK_INTERVAL=60
