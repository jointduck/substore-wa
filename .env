ACCOUNT_DATA_TTL_DAYS=30
── Mini App (веб-магазин) ────────────────────────────────────────

# Порт HTTP-сервера бота (health + Mini App + API). ОБЯЗАТЕЛЕН для
# хостинга: без него сервер вообще не запустится и магазину некуда
# будет открываться. На VPS под nginx ставь 8000 (nginx проксирует
# 80/443 → 127.0.0.1:8000). На Render/Railway переменную PORT задаёт
# платформа сама — ничего вписывать не нужно.
PORT=

# Базовый публичный URL health-сервера (БЕЗ /app/). Примеры:
#   VPS:   WEBAPP_URL=https://твой-домен.ру
Render: WEBAPP_URL=https://substore-8yic.onrender.com
# Магазин откроется на {WEBAPP_URL}/app/ и в меню чата появится
# кнопка «🛍 Магазин». Пусто = магазин только по прямой ссылке.
# WEBAPP_URL=
# Название магазина в шапке Mini App
STORE_NAME=IndiaSubStore


# ─── Гигиена чата ──────────────────────────────────────────────────

# Дедупликация: стираются ТОЛЬКО дубли — повторное открытие каталога /
# повтор команды / повторная оплата того же заказа удаляют предыдущую копию.
# Карточки заказов, оплаты и уведомления не удаляются никогда.
CHAT_DEDUP_ENABLED=true

# Дедуп и в админских чатах (Task 35, решение владельца «во всех чатах»).
# false — прежнее поведение: админский чат не затрагивается дедупом.
DEDUP_ADMINS=true

# Ephemeral-растворение переходных сообщений (Task 35): FSM-подсказки и
# ошибки стираются после завершения ввода, команды и нажатия кнопок меню
# юзера — через ~5 с во всех личных чатах. Критичные экраны (деньги,
# заказы, каталог, уведомления) не растворяются никогда.
EPHEMERAL_ENABLED=true

# Нативные Ephemeral Messages (Bot API 10.3): transient-сообщения уходят
# с ephemeral_message_parameters — жизнью управляет Telegram. При любом
# отказе API бот тихо откатывается на классику. По умолчанию выключен:
# классика гарантирует доставку переходного сообщения.
EPHEMERAL_NATIVE=false

# ─── Прочее (опция) ────────────────────────────────────────────────

# Пауза между сообщениями рассылки (сек) — анти-флуд Telegram
BROADCAST_DELAY=0.05
# Интервал проверки напоминаний/маркетинга (сек)
NOTIFY_CHECK_INTERVAL=30

# Auto-generated encryption key — KEEP SECRET!
ENCRYPTION_KEY=KKT42QzQScXiOrFe473lW4RjRnaqx5eX03tvWvNHWzI=

# ─── Яндекс Метрика: офлайн-конверсии для Директа (v19) ────────────
# Покупки в боте выгружаются в Метрику по yclid → в Директе появляется
# цель с доходом → автостратегии «Оплата за конверсии» optimizируют
# по реальным продажам.
# Настройка (один раз):
#   1. metrika.yandex.ru → счётчик → Настройка → «Загрузка данных» →
#      включить «Офлайн-конверсии» (принять условия).
#   2. oauth.yandex.ru → приложение с доступом «API Яндекс.Метрики»
#      (metrica:write) → токен.
#   3. Заполнить обе переменные и перезапустить бота.
#   4. В объявлениях Директа ставить ссылку на редирект бота:
#      https://<адрес-бота>/r/?utm_source=yandex&utm_medium=cpc&utm_campaign=Кампания
#      (Директ сам добавит yclid; бот развернёт его в /start c_<id>).
# Без заполнения бот работает как раньше (UTM-статистика в «Директе»).
# METRICA_COUNTER_ID=12345678
# METRICA_OAUTH_TOKEN=y0_AgAAAA...
# Название цели в отчётах Метрики/Директа
# METRICA_TARGET_NAME=purchase
# Валюта выгрузки (для «конверсий с доходом»)
# METRICA_CURRENCY=USD
# Интервал выгрузки (сек)
# METRICA_UPLOAD_INTERVAL=900

# ─── Публичный адрес бота (рекламный редирект /r/) ────────────────
# На Render подхватывается автоматически из RENDER_EXTERNAL_URL.
# Если хостинг другой — впишите вручную (без слэша на конце):
# PUBLIC_BASE_URL=https://ваш-сервис.onrender.com
# Тогда раздел «Директ» покажет готовую ссылку для объявлений:
# https://ваш-сервис.onrender.com/r/?utm_source=yandex&utm_medium=cpc&utm_campaign=Кампания